# deps & build
node_modules
.next
out
dist
coverage
tsconfig.tsbuildinfo

# git / editor / agent junk (shrink build context)
.git
.gitignore
.DS_Store
*.swp
.idea
.vscode
.claude
.grok
.cursor
*.md
!README.md
docs
deploy
Agents.md
AGENTS.md
Claude.md
CLAUDE.md

# env & secrets — never bake into image
.env
.env.*
!.env.example

# local uploads are large; mount as volume in production
public/uploads/**
!public/uploads/.gitkeep
uploads
uploads/**

# Runtime state is bind-mounted; never send as build context
# (postgres data dir is root-only and breaks docker build)
runtime
runtime/**

# comments are runtime; trips.json is seeded from data/
data/comments/**
!data/comments/.gitkeep
data

# logs
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
