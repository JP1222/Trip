# ── Admin (required in production) ─────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Session / capability HMAC key (min 32 chars). Replaces legacy ADMIN_SECRET.
APP_SECRET=another-long-random-string-for-cookies-and-capabilities

# Public origin only, e.g. https://trip.jpzen.cn (required in production)
APP_ORIGIN=http://localhost:3000

# ── PostgreSQL ─────────────────────────────────────────
# When unset, the app falls back to data/trips.json + data/comments + public/uploads.
DATABASE_URL=postgresql://trip:trip@127.0.0.1:5432/trip
# DATABASE_SSL=disable
# DATABASE_POOL_MAX=10

POSTGRES_DB=trip
POSTGRES_USER=trip
POSTGRES_PASSWORD=trip
POSTGRES_PORT=5432

# ── Media roots (absolute paths in Docker) ─────────────
# Local defaults are under ./runtime/
# MEDIA_PRIVATE_ROOT=/app/media-private
# MEDIA_PUBLIC_ROOT=/app/media-public
# MEDIA_PUBLIC_BASE_URL=/media
# MEDIA_BACKEND=db

# ── Media worker ───────────────────────────────────────
# MEDIA_WORKER_ID=local-1
# MEDIA_IMAGE_CONCURRENCY=2
# MEDIA_VIDEO_CONCURRENCY=1
# MEDIA_JOB_LEASE_SECONDS=300

# ── Upload limits (bytes) ──────────────────────────────
# MAX_IMAGE_UPLOAD_BYTES=31457280
# MAX_VIDEO_UPLOAD_BYTES=110100480
# MAX_UPLOAD_REQUEST_BYTES=134217728

# ── Proxy ──────────────────────────────────────────────
# Number of trusted reverse-proxy hops (Traefik = 1)
TRUST_PROXY_HOPS=0

# ── Docker / Traefik (Oracle) ───────────────────────────
# TRIP_HOST=trip.jpzen.cn
# TRIP_IMAGE_TAG=latest
# LEGACY_UPLOADS_PATH=./uploads

# ── Maps (at least one key required for the trip map) ─
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
# NEXT_PUBLIC_MAP_PROVIDER=mapbox
