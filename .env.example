# ── Required (Postgres is the only data mode) ──────────
DATABASE_URL=postgresql://trip:trip@127.0.0.1:5432/trip
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Session / capability HMAC key (min 32 bytes). Never reuse ADMIN_PASSWORD.
APP_SECRET=another-long-random-string-for-cookies-and-capabilities
# Public origin only (https required in production)
APP_ORIGIN=http://localhost:3000

# Soft branding for this deployment (code/domain stay "trip")
SITE_NAME=Peng
SITE_TAGLINE=Travel notes, photos, and writing.

# ── PostgreSQL (compose) ───────────────────────────────
POSTGRES_DB=trip
POSTGRES_USER=trip
POSTGRES_PASSWORD=trip
POSTGRES_PORT=5432
# DATABASE_SSL=disable
# DATABASE_POOL_MAX=10

# ── Media roots (absolute in Docker) ───────────────────
# Local defaults: ./runtime/media-private and ./runtime/media-public
# MEDIA_PRIVATE_ROOT=/app/media-private
# MEDIA_PUBLIC_ROOT=/app/media-public
# MEDIA_PUBLIC_BASE_URL=/media
# LEGACY_UPLOADS_ROOT=/app/legacy-uploads

# ── Media worker ───────────────────────────────────────
# MEDIA_WORKER_ID=local-1
# MEDIA_IMAGE_CONCURRENCY=2
# MEDIA_VIDEO_CONCURRENCY=1
# MEDIA_JOB_LEASE_SECONDS=300
# Dev only (never production): process derivatives inside the web process
# MEDIA_INLINE_PROCESS=1

# ── Upload limits (bytes) ──────────────────────────────
# MAX_IMAGE_UPLOAD_BYTES=31457280
# MAX_VIDEO_UPLOAD_BYTES=110100480
# MAX_UPLOAD_REQUEST_BYTES=134217728

# ── Proxy / sessions ───────────────────────────────────
# Trusted reverse-proxy hops (Traefik = 1, local = 0)
TRUST_PROXY_HOPS=0
# ADMIN_SESSION_TTL_SECONDS=86400

# ── Docker / Traefik ───────────────────────────────────
# TRIP_HOST=trip.jpzen.cn
# TRIP_IMAGE_TAG=latest
# LEGACY_UPLOADS_PATH=./public/uploads
# BACKUP_ROOT=./runtime/backups
# BACKUP_KEEP=14

# ── Maps ───────────────────────────────────────────────
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
# NEXT_PUBLIC_MAP_PROVIDER=mapbox
