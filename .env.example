# ── Admin (required on server) ─────────────────────────
# Use strong values in production — never ship admin/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
ADMIN_SECRET=another-long-random-string-for-cookies

# ── Docker / Traefik (Oracle) ───────────────────────────
# Production: https://trip.jpzen.cn behind Traefik (no host port needed).
# Secure admin cookies require HTTPS (NODE_ENV=production).

# ── Maps (at least one key required for the trip map) ─
# Sidebar shows Mapbox | Google tabs when both keys are set.
#
# Mapbox: https://account.mapbox.com/access-tokens/
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...
#
# Google Maps JS API (enable “Maps JavaScript API” + billing):
# https://console.cloud.google.com/google/maps-apis
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
#
# Default when several are ready: mapbox | google
# NEXT_PUBLIC_MAP_PROVIDER=mapbox
